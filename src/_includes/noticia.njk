---
layout: base.njk
tipoSocial: article
---
<div class="contenedor contenedor--lectura">
  <div class="titular">
    <p class="titular__categoria">Actualidad</p>
    <h1>{{ titulo }}</h1>
    <p class="titular__entrada">{{ entrada }}</p>
  </div>
</div>

<div class="contenedor contenedor--lectura">
  <article class="texto">
    {% if autor.nombre %}
    <div class="contribucion__autoria">
      <p class="contribucion__autor">{{ autor.nombre }}</p>
      {% if autor.perfil %}<p class="contribucion__perfil">{{ autor.perfil }}</p>{% endif %}
      {% if autor.vinculacion == "colaborador" %}<p class="contribucion__datos"><a href="/colaboradores/">Colaborador del Seminario Permanente</a></p>{% endif %}
    </div>
    {% endif %}
    <p class="noticia__fecha">
      <time datetime="{{ page.date | fechaISO }}">{{ page.date | fechaLarga }}</time>
    </p>

    {{ content | safe }}

    <hr>
    <p><a href="/actualidad/">Volver a Actualidad</a></p>
  </article>
</div>
